<%@ Master Language="C#" AutoEventWireup="true"
    CodeBehind="Site.master.cs"
    Inherits="TPC_TiendaRopa.SiteMaster" %>

<!DOCTYPE html>

<html lang="es">
<head runat="server">

    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title><%: Page.Title %> - Tienda de Ropa</title>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>

    <webopt:BundleReference
        runat="server"
        Path="~/Content/css" />

</head>

<body>

<form runat="server">

    <asp:ScriptManager runat="server">
        <Scripts>
            <asp:ScriptReference Name="MsAjaxBundle" />
            <asp:ScriptReference Name="jquery" />
            <asp:ScriptReference Name="WebFormsBundle" />
        </Scripts>
    </asp:ScriptManager>

    <nav class="navbar navbar-expand-sm navbar-dark bg-dark">

        <div class="container">

            <a class="navbar-brand"
               runat="server"
               href="~/Clientes.aspx">
                Tienda de Ropa
            </a>

            <asp:Panel
                ID="menuPrincipal"
                runat="server">

                <ul class="navbar-nav">

                    <li class="nav-item">
                        <a class="nav-link"
                           runat="server"
                           href="~/Clientes.aspx">
                            Clientes
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           runat="server"
                           href="~/Marcas.aspx">
                            Marcas
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           runat="server"
                           href="~/Productos.aspx">
                            Productos
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           runat="server"
                           href="~/Proveedores.aspx">
                            Proveedores
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           runat="server"
                           href="~/Tipos.aspx">
                            Tipos
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           runat="server"
                           href="~/Usuarios.aspx">
                            Usuarios
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           runat="server"
                           href="~/Compras.aspx">
                            Compras
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           runat="server"
                           href="~/Ventas.aspx">
                            Ventas
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           runat="server"
                           href="~/Factura.aspx">
                            Factura
                        </a>
                    </li>

                </ul>

            </asp:Panel>

            <asp:Panel
                ID="panelUsuario"
                runat="server">

                <asp:Label
                    ID="lblUsuario"
                    runat="server"
                    CssClass="text-light me-3">
                </asp:Label>

                <asp:Button
                    ID="btnCerrarSesion"
                    runat="server"
                    Text="Cerrar sesión"
                    CssClass="btn btn-outline-light btn-sm"
                    OnClick="btnCerrarSesion_Click" />

            </asp:Panel>

        </div>

    </nav>

    <div class="container mt-4">

        <asp:ContentPlaceHolder
            ID="MainContent"
            runat="server">
        </asp:ContentPlaceHolder>

        <hr />

        <footer>
            <p>
                &copy; <%: DateTime.Now.Year %>
                - Tienda de Ropa
            </p>
        </footer>

    </div>

</form>

</body>
</html>