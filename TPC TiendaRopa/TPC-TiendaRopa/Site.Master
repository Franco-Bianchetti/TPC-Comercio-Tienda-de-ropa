<%@ Master Language="C#" AutoEventWireup="true"
    CodeBehind="Site.master.cs"
    Inherits="TPC_TiendaRopa.SiteMaster" %>

<!DOCTYPE html>

<html lang="es">
<head runat="server">

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title><%: Page.Title %> - Tienda de Ropa</title>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>

    <webopt:BundleReference runat="server" Path="~/Content/css" />

</head>

<body>

    <form runat="server">

        <asp:ScriptManager runat="server">
            <Scripts>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebFormsBundle" />
            </Scripts>
        </asp:ScriptManager>

<nav class="navbar navbar-expand-sm navbar-dark bg-dark">

    <div class="container">

        <a class="navbar-brand" runat="server" href="~/">Tienda de Ropa</a>

        <ul class="navbar-nav">
            <li class="nav-item"><a class="nav-link" runat="server" href="~/">Inicio</a></li>
            <li class="nav-item"><a class="nav-link" runat="server" href="~/Clientes">Clientes</a></li>
            <li class="nav-item"><a class="nav-link" runat="server" href="~/Marcas">Marcas</a></li>
            <li class="nav-item"><a class="nav-link" runat="server" href="~/Productos">Productos</a></li>
            <li class="nav-item"><a class="nav-link" runat="server" href="~/Proveedores">Proveedores</a></li>
            <li class="nav-item"><a class="nav-link" runat="server" href="~/Tipos">Tipos</a></li>
        </ul>

    </div>

</nav>
        <div class="container mt-4">

            <asp:ContentPlaceHolder
                ID="MainContent"
                runat="server">
            </asp:ContentPlaceHolder>

            <hr />

            <footer>
                <p>
                    &copy; <%: DateTime.Now.Year %> - Tienda de Ropa
                </p>
            </footer>

        </div>

    </form>

</body>
</html>
